# Line-ending pins: the first-boot runners are staged byte-for-byte onto VMs,
# so their EOLs must not depend on who checked the repo out.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf
# Autoinstall seed files are read on Linux guests; CRLF would break YAML/units.
base-vm-setup/linux-server/autoinstall/user-data text eol=lf
*.service text eol=lf
